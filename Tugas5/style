* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f0f4f8;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.container {
    background: white;
    width: 100%;
    max-width: 450px;
    padding: 30px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

h1 {
    color: #24292f;
    margin-bottom: 10px;
}

.container > p {
    color: #666;
    margin-bottom: 20px;
}

form {
    display: flex;
    gap: 8px;
}

input {
    flex: 1;
    min-width: 0;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 7px;
    outline: none;
}

button {
    padding: 12px 15px;
    background: #238636;
    color: white;
    border: none;
    border-radius: 7px;
    cursor: pointer;
}

button:hover {
    background: #196c2e;
}

#loading {
    margin-top: 20px;
    color: #0969da;
}

#message {
    margin-top: 15px;
    color: #d1242f;
}

.profile-card {
    margin-top: 25px;
    padding: 20px;
    border: 1px solid #ddd;
    border-radius: 12px;
}

.profile-card img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin-bottom: 15px;
}

.profile-card h2 {
    color: #24292f;
    margin-bottom: 10px;
}

.profile-card p {
    margin-bottom: 12px;
    color: #555;
}

.profile-card a {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 15px;
    background: #0969da;
    color: white;
    text-decoration: none;
    border-radius: 7px;
}

.profile-card a:hover {
    background: #0550ae;
}

@media (max-width: 400px) {
    form {
        flex-direction: column;
    }
}